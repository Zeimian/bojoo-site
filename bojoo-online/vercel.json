{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/cost", "destination": "/cost/index.html" },
    { "source": "/review", "destination": "/review/index.html" },
    { "source": "/social", "destination": "/social/index.html" },
    { "source": "/xhs", "destination": "/social/index.html" },
    { "source": "/bi", "destination": "/bi-demo/index.html" },
    { "source": "/bi-demo", "destination": "/bi-demo/index.html" },
    { "source": "/opencloud", "destination": "/opencloud/index.html" },
    { "source": "/claw", "destination": "/opencloud/index.html" },
    { "source": "/docs-cost", "destination": "/docs-cost/index.html" },
    { "source": "/docs-review", "destination": "/docs-review/index.html" },
    { "source": "/docs-social", "destination": "/docs-social/index.html" },
    { "source": "/zhuguang", "destination": "/zhuguang/index.html" },
    { "source": "/api-demo", "destination": "/api-demo/index.html" },
    { "source": "/rd", "destination": "/rd/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "rd.bojoo.online" }], "destination": "/rd/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "cost.bojoo.online" }], "destination": "/cost/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "review.bojoo.online" }], "destination": "/review/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "xhs.bojoo.online" }], "destination": "/social/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "social.bojoo.online" }], "destination": "/social/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "bi.bojoo.online" }], "destination": "/bi-demo/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "openclaw.bojoo.online" }], "destination": "/opencloud/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "docs-cost.bojoo.online" }], "destination": "/docs-cost/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "docs-review.bojoo.online" }], "destination": "/docs-review/index.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "zhuguang.bojoo.online" }], "destination": "/zhuguang/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
